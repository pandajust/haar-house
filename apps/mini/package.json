{
  "name": "mini",
  "version": "0.1.0",
  "private": true,
  "description": "理发店客户小程序 - Taro 3 + React 18 + TypeScript + Tailwind",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "3.6.25",
    "@tarojs/helper": "3.6.25",
    "@tarojs/react": "3.6.25",
    "@tarojs/router": "3.6.25",
    "@tarojs/runtime": "3.6.25",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "3.6.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@tarojs/cli": "3.6.25",
    "@tarojs/plugin-framework-react": "3.6.25",
    "@tarojs/plugin-platform-h5": "3.6.25",
    "@tarojs/plugin-platform-weapp": "3.6.25",
    "@tarojs/webpack5-runner": "3.6.25",
    "@types/react": "^18.2.0",
    "@types/webpack-env": "^1.18.0",
    "autoprefixer": "^10.4.19",
    "babel-preset-taro": "3.6.25",
    "eslint": "^8.57.0",
    "eslint-config-taro": "3.6.25",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.38",
    "react-refresh": "^0.14.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "weapp-tailwindcss": "^3.1.0"
  }
