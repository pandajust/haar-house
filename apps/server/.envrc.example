# 复制为 .env 后按需修改；.env 不入库
# 服务
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:10086

# 数据库
DATABASE_URL=postgresql://hair:hair_pass@localhost:5432/hair
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-min-32-chars-long-string
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# 微信小程序
WX_APPID=your-mini-appid
WX_SECRET=your-mini-secret

# 阿里云 OSS
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=hair-salon
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# 阿里云短信
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=

# API
API_PREFIX=api
SWAGGER_PREFIX=api/docs
