{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "理发店管理系统 - 管理后台（Vite + React 18 + Ant Design Pro 5 + TS strict）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173",
